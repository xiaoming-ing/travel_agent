# ===== 必填：第三方 API Key =====
DEEPSEEK_API_KEY='deepseek 的 api_key'      # LLM（Phase1 工具调用 + Phase2 行程生成）
GAODE_API_KEY='高德 web 服务 api_key'        # 景点 / 酒店 POI 搜索
WEATHER_API_KEY='和风天气 api_key'           # 天气预报
WEATHER_API_HOST='和风天气 api_host'         # 和风的专属 host

# ===== 可选：运行配置（不填走默认值）=====
# 对话状态 + 历史记录的 SQLite 文件路径，默认 checkpoints.db
# 部署时建议指向持久化数据卷，如 /data/checkpoints.db
CHECKPOINTS_DB='checkpoints.db'

# 允许跨域的前端来源，逗号分隔。默认本地 Vite 端口
# 部署时改成前端真实域名，如 https://your-frontend.com
CORS_ORIGINS='http://localhost:5173,http://127.0.0.1:5173'

# 日志级别：DEBUG / INFO / WARNING / ERROR，默认 INFO
# 开发排查时设 DEBUG，生产设 INFO
LOG_LEVEL='INFO'

DEFAULT_TOKEN_QUOTA=200000